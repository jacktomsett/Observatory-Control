{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        // Build tasks
        {
            "label": "build workspace",
            "detail": "Build ROS 2 workspace",
            "type": "shell",
            "command": "source /opt/ros/jazzy/setup.bash && colcon build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build single package",
            "detail": "Build single ROS 2 package",
            "type": "shell",
            "command": "source /opt/ros/jazzy/setup.bash && colcon build --packages-select ${input:package}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "clean workspace",
            "detail": "Remove built coode from workspace",
            "type": "shell",
            "command": "rm -r ${workspaceFolder}/{build,install,log}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "package",
            "type": "promptString",
            "description": "Package name",
            "default": "demo_nodes_cpp"
        }
    ]
}