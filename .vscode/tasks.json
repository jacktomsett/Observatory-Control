{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "${fileDirname}/${fileBasename}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lcurl",
                "-ljsoncpp",
                "-I",
                "${fileDirname}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "colcon: build",
            "command": [
                "source /opt/ros/rolling/setup.bash;",
                "colcon build"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "colcon: clean",
            "type": "shell",
            "command": [
                "cd ${workspaceFolder} && rm -rf build/ install/ log/;"
            ],
            "problemMatcher": []
        }
    ]
}